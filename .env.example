# Core
PROJECT_NAME=nTrade AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ntrade_ai_dev
DATABASE_USER=ntrade_ai_user
DATABASE_PASSWORD=change_me
DATABASE_ADMIN_USER=postgres
DATABASE_ADMIN_PASSWORD=change_me

# MT5
MT5_ACCOUNT_NUMBER=
MT5_PASSWORD=
MT5_SERVER=Weltrade-Demo
MT5_DEMO_MODE=true
MT5_AUTO_CONNECT=false
DEFAULT_SYMBOL=XAUUSD
GOLD_HISTORY_SYMBOL=XAUUSD_i
DEFAULT_TIMEFRAME=60

# Risk
MAX_RISK_PER_TRADE=2.0
MAX_DAILY_LOSS_PERCENT=5.0
MAX_CONCURRENT_TRADES=3

# Data
HISTORICAL_DATA_YEARS=5
BACKTEST_DATA_START_DATE=2020-01-01
BROKER_BASE_URL=http://127.0.0.1:8001

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

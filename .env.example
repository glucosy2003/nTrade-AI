# Core
PROJECT_NAME=nTrade AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ntrade_ai_dev
DATABASE_USER=ntrade_ai_user
DATABASE_PASSWORD=change_me
DATABASE_ADMIN_USER=postgres
DATABASE_ADMIN_PASSWORD=change_me
DATABASE_ECHO=false

# MT5
MT5_ACCOUNT_NUMBER=
MT5_PASSWORD=
MT5_SERVER=Weltrade-Demo
MT5_DEMO_MODE=true
MT5_AUTO_CONNECT=false

# Synthetic MT5 account, separate from the commodity/gold account
SYNTHETIC_MT5_ACCOUNT_NUMBER=
SYNTHETIC_MT5_PASSWORD=
SYNTHETIC_MT5_SERVER=
SYNTHETIC_MT5_TERMINAL_PATH=
SYNTHETIC_MT5_DEMO_MODE=true

# Default symbol for generic MT5 inspection/startup tools
DEFAULT_SYMBOL=FX Vol 20
# Optional legacy gold-history sync symbol; not used by synthetic trading runners
GOLD_HISTORY_SYMBOL=XAUUSD_i
DEFAULT_TIMEFRAME=60
SYNTHETIC_INDEX_20_SYMBOL=FX Vol 20
SYNTHETIC_INDEX_40_SYMBOL=FX Vol 40
SYNTHETIC_INDEX_80_SYMBOL=FX Vol 80
SYNTHETIC_INDEX_20_SEARCH_TERMS=fx,vol,20
SYNTHETIC_INDEX_40_SEARCH_TERMS=fx,vol,40
SYNTHETIC_INDEX_80_SEARCH_TERMS=fx,vol,80
SYNTHETIC_MAX_TRADES_PER_DAY=6
SYNTHETIC_MAX_TRADES_PER_SYMBOL_PER_DAY=2
SYNTHETIC_DEMO_ONLY=true

# Risk
MAX_RISK_PER_TRADE=2.0
MAX_DAILY_LOSS_PERCENT=5.0
MAX_CONCURRENT_TRADES=3

# Data
HISTORICAL_DATA_YEARS=5
BACKTEST_DATA_START_DATE=2020-01-01
BROKER_BASE_URL=http://127.0.0.1:8001

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
